{
  "name": "dsh-wb-cli",
  "version": "1.6.3",
  "private": true,
  "description": "小胰宝/小x宝社区 DSH Workbench Git 分发与项目初始化工具",
  "type": "module",
  "bin": {
    "dsh-wb-cli": "./bin/dsh-wb-cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "cli",
    "scripts",
    "project-template",
    "project.config.example.json",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "docs",
    "spec",
    "templates",
    "prompts",
    "assets",
    "reference",
    "examples",
    "skills",
    "test"
  ],
  "scripts": {
    "check": "node --check bin/dsh-wb-cli.mjs && node --check cli/main.mjs && node --check scripts/init.mjs && node --check project-template/scripts/check-install.mjs && node --check scripts/check-conformance.mjs && node --check scripts/probe-disease-primer.mjs && node scripts/check-starter.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "probe:primer": "node scripts/probe-disease-primer.mjs"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyb-openharness-dsh-plugins/xyb-workbench-starter.git"
  }
}
